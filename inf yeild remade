local function CreateUI()
    -- Main GUI frame
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MegaAdminHub"
    screenGui.Parent = LocalPlayer.PlayerGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 600, 0, 500)
    mainFrame.Position = UDim2.new(0.5, -300, 0.5, -250)
    mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    mainFrame.BorderSizePixel = 2
    mainFrame.BorderColor3 = Color3.fromRGB(0, 255, 200)
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = screenGui

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 30)
    titleBar.BackgroundColor3 = Color3.fromRGB(0, 40, 40)
    titleBar.Parent = mainFrame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -50, 1, 0)
    title.Text = "MEGA ADMIN HUB – 300+ COMMANDS"
    title.TextColor3 = Color3.fromRGB(0, 255, 200)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.Code
    title.TextScaled = true
    title.Parent = titleBar

    -- Close button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 1, 0)
    closeBtn.Position = UDim2.new(1, -30, 0, 0)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeBtn.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
    closeBtn.BorderSizePixel = 0
    closeBtn.Font = Enum.Font.Code
    closeBtn.TextScaled = true
    closeBtn.Parent = titleBar
    closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

    -- Drag functionality
    local dragging = false
    local dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Search bar
    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -10, 0, 30)
    searchBox.Position = UDim2.new(0, 5, 0, 35)
    searchBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    searchBox.TextColor3 = Color3.fromRGB(200, 255, 200)
    searchBox.PlaceholderText = "Search commands..."
    searchBox.Font = Enum.Font.Code
    searchBox.TextScaled = true
    searchBox.Parent = mainFrame

    -- Command list container
    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, -10, 1, -120)
    listFrame.Position = UDim2.new(0, 5, 0, 70)
    listFrame.BackgroundTransparency = 1
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.ScrollBarThickness = 6
    listFrame.Parent = mainFrame

    -- UIListLayout for commands
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    layout.Parent = listFrame
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    -- Populate commands
    local function RefreshList(filter)
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, cmd in ipairs(Commands) do
            local lowerCmd = cmd.Command:lower()
            if not filter or string.find(lowerCmd, filter:lower()) or string.find(cmd.Description:lower(), filter:lower()) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 25)
                btn.Text = cmd.Command .. " – " .. cmd.Description .. " (" .. cmd.Category .. ")"
                btn.TextColor3 = Color3.fromRGB(200, 255, 200)
                btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                btn.BorderSizePixel = 1
                btn.BorderColor3 = Color3.fromRGB(0, 200, 150)
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Font = Enum.Font.Code
                btn.TextScaled = true
                btn.Parent = listFrame
                btn.MouseButton1Click:Connect(function()
                    pcall(cmd.Function, {})
                end)
            end
        end
    end

    RefreshList()

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        RefreshList(searchBox.Text)
    end)

    -- Bottom status bar
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -10, 0, 25)
    status.Position = UDim2.new(0, 5, 1, -30)
    status.Text = "Type ;command in chat or click buttons. 300+ commands loaded."
    status.TextColor3 = Color3.fromRGB(150, 200, 150)
    status.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    status.Font = Enum.Font.Code
    status.TextScaled = true
    status.Parent = mainFrame
end

