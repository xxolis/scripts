-- ===== CHAT DETECTION =====
game:GetService("Players").LocalPlayer.Chatted:Connect(function(msg)
    if string.sub(msg, 1, 1) == Prefix then
        local cmdText = string.sub(msg, 2)
        local args = {}
        for word in cmdText:gmatch("%S+") do
            table.insert(args, word)
        end
        local cmdName = args[1] and args[1]:lower() or ""
        table.remove(args, 1)
        -- Find command
        for _, cmd in ipairs(Commands) do
            if cmd.Command:lower() == cmdName then
                pcall(cmd.Function, args)
                break
            end
        end
    end
end)

